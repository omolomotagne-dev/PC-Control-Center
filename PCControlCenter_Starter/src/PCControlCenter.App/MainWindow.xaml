<Window x:Class="PCControlCenter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Control Center" Height="720" Width="1120" MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
<Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#FF0B1220" CornerRadius="14" Padding="16" Margin="0,0,16,0"><StackPanel>
<TextBlock Text="PC CONTROL" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="CENTER" FontSize="20" FontWeight="Bold" Margin="0,0,0,24"/>
<Button Content="Tableau de bord" Padding="10" Margin="0,3"/><Button Content="Matériel" Padding="10" Margin="0,3"/><Button Content="Diagnostics" Padding="10" Margin="0,3"/><Button Content="Mode jeu" Padding="10" Margin="0,3"/><Button Content="Maintenance" Padding="10" Margin="0,3"/><Button Content="Paramètres" Padding="10" Margin="0,3"/>
<TextBlock Text="APERÇU INITIAL — DONNÉES DE DÉMO" Foreground="#FF8AA7C7" TextWrapping="Wrap" Margin="0,25,0,0"/>
</StackPanel></Border>
<ScrollViewer Grid.Column="1"><StackPanel><TextBlock Text="Tableau de bord" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Surveillance et outils système" Foreground="#FF8AA7C7" Margin="0,4,0,20"/>
<UniformGrid Columns="2"><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,10,10"><StackPanel><TextBlock Text="PROCESSEUR" Foreground="#FF8AA7C7"/><TextBlock Text="En attente" FontSize="26" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Collecteur CPU à connecter."/></StackPanel></Border>
<Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="MÉMOIRE RAM" Foreground="#FF8AA7C7"/><TextBlock Text="En attente" FontSize="26" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Les mesures réelles remplaceront cet état."/></StackPanel></Border>
<Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="STOCKAGE" Foreground="#FF8AA7C7"/><TextBlock Text="Non analysé" FontSize="26" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Analyse à la demande prévue."/></StackPanel></Border>
<Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="CAPTEURS" Foreground="#FF8AA7C7"/><TextBlock Text="Non détectés" FontSize="26" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Aucune température ne sera inventée si le matériel ne la fournit pas."/></StackPanel></Border></UniformGrid>
<Border Background="#FF0B1220" BorderBrush="#FF174A70" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,20,0,0"><StackPanel><TextBlock Text="État du système" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Squelette initial prêt pour brancher les collecteurs réels." TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="Ces états sont des démonstrations, pas des mesures de votre PC." Foreground="#FF8AA7C7" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></Grid></Window>
